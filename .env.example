# Copy to .env for local development. Never commit real values.
# On Replit, set these in Secrets for BOTH the workspace and the Deployment.

# Database
DATABASE_URL=

# LLMs
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=

# Admin auth (server-side). Admin login is disabled (503) until BOTH are set.
# ADMIN_PASSWORD: strong password, exchanged at POST /api/admin/login for a bearer token.
ADMIN_PASSWORD=
# ADMIN_TOKEN_SECRET: HMAC key for admin tokens, at least 32 chars (e.g. `openssl rand -hex 32`).
# Rotating it (or ADMIN_PASSWORD) invalidates all issued admin tokens.
ADMIN_TOKEN_SECRET=

# Static bearer token for automated POST /api/articles/bulk callers (falls back to ADMIN_PASSWORD).
BULK_IMPORT_SECRET=

# Runtime
PORT=
NODE_ENV=
LOG_LEVEL=

# Web build
BASE_PATH=
GA4_MEASUREMENT_ID=
